apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: cessda-mgmt-alerts
  namespace: monitoring
  labels:
    release: kube-prometheus-stack
spec:
  groups:
  - name: cessda-mgmt
    rules:
    - alert: TestAlertAlwaysFiring
      expr: vector(1)
      for: 1m
      labels:
        severity: test
      annotations:
        summary: "Test alert to check the pipeline"
    - alert: PodNotReady
      expr: kube_pod_status_ready{namespace=~"cessda-mgmt|jenkins|argocd",condition="false"} == 1
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "Pod {{ $labels.pod }} in {{ $labels.namespace }} not ready for 5 minutes"


kubectl get secret alertmanager-kube-prometheus-stack-alertmanager -n monitoring -o jsonpath='{.data.alertmanager\.yaml}' | base64 -d

prometheus:
  prometheusSpec:
    ruleSelectorNilUsesHelmValues: false


